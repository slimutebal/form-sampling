# Vite exposes variables prefixed with VITE_ to client code.
# No variable is secret once it ships in the client bundle (see docs/TECH_STACK.md ADR-037/038).
#
# VITE_APP_ENV selects the running environment label (e.g. development, production).
VITE_APP_ENV=development

# Deployed Google Apps Script Web App endpoint for master-data reads.
# This is a browser-visible URL, not a credential. Never place OAuth client
# IDs, client secrets, service-account JSON, or access tokens in this app.
VITE_GOOGLE_APPS_SCRIPT_URL=
